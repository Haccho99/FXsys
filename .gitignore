# ==============================================================================
# FX自動取引システム .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 機密情報・認証情報 (Critical Secrets)
# ------------------------------------------------------------------------------
# OANDA API、OpenAI/Gemini/NewsAPIキー、Discordトークン、Redis認証などを含む本番設定
config.json
config_backups/

# 環境変数・各種シークレット
.env
.env.*
*.env
*.pem
*.key
*.p12
*.crt

# ------------------------------------------------------------------------------
# 2. ログ・キャッシュ・一時ファイル (Runtime, Logs & Cache)
# ------------------------------------------------------------------------------
# 実行ログ（大容量log、Parquetログ、CSVログなど）
logs/
*.log

# 計算インジケーター等のキャッシュ
cache/

# バックアップ・一時フォルダ
backup/
temp/
tmp/

# 並行処理・最適化時のプロセスロックファイル
*.lock
*.parquet.lock

# バックテスト結果・ダッシュボードエクスポートCSV
*_export.csv
latest_export.csv

# ターミナル実行・調査ログのテキストファイル
*_analysis.txt
latest_analysis*.txt
mock_analysis.txt
time_analysis.txt
vbt_help.txt
vbt_sig.txt

# ------------------------------------------------------------------------------
# 3. マーケットデータ・ヒストリカルデータ (Market Data)
# ------------------------------------------------------------------------------
# 大容量ヒストリカルデータ（Parquet、日次CSV、バックアップ）
# ※ 価格データをGit管理対象にするため除外を解除
# data/
# *.parquet
*.parquet.bak

# ------------------------------------------------------------------------------
# 4. 機械学習モデルバイナリ (ML Models)
# ------------------------------------------------------------------------------
# 学習済みモデル（train_ai_model.py 等で再生成可能）
*.joblib
*.pkl
*.model
*.onnx

# ------------------------------------------------------------------------------
# 5. 日本語フォントバイナリ (Fonts)
# ------------------------------------------------------------------------------
# 大容量フォントファイル (~20MB)
fonts/
*.ttf
*.otf

# ------------------------------------------------------------------------------
# 6. Python標準成果物・仮想環境 (Python & Virtual Environments)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# 仮想環境
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# テスト・カバレッジ成果物
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/
nosetests.xml
coverage.xml

# Jupyter Notebook キャッシュ
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 7. 一時的な検証スクリプト (Scratch & Temp Scripts)
# ------------------------------------------------------------------------------
scratch.py
temp_*.py

# ------------------------------------------------------------------------------
# 8. OS・エディタ固有ファイル (OS & IDE Specific)
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# IDE / エディタ
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~
